<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_ringing"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="48dp"
    android:paddingBottom="48dp"
    android:keepScreenOn="true">

    <!-- Top Branding & Icon -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivBell"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Aurora Bell"
            android:src="@drawable/ic_bell_alarm" />

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.2"
            android:text="AURORA ALARME"
            android:textColor="@color/neon_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Clock & Metadata -->
    <LinearLayout
        android:id="@+id/centerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:includeFontPadding="false"
            android:shadowColor="@color/neon_cyan_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="24"
            android:text="07:30"
            android:textColor="@color/neon_cyan"
            android:textSize="76sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Segunda-feira, 28 de Setembro"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Hora de acordar!"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Desperte com energia e foco"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bottom Actions Container -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Soneca Button -->
        <Button
            android:id="@+id/btnSnooze"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/btn_snooze_gradient"
            android:letterSpacing="0.05"
            android:stateListAnimator="@null"
            android:text="Soneca (+10m)"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Desligar Button -->
        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/btn_dismiss_gradient"
            android:elevation="6dp"
            android:letterSpacing="0.1"
            android:stateListAnimator="@null"
            android:text="DESLIGAR"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
